# DateLimit environment configuration
# Copy this file to .env and adjust the values for your local environment.
# Never commit the real .env file.

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# Database
# Current development database: SQLite
DATABASE_URL=sqlite:///database/datelimit.db

# Future PostgreSQL preparation
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=datelimit
# DB_USER=postgres
# DB_PASSWORD=change_me

# Reports / exports
EXPORT_DIR=exports

# Logging
LOG_LEVEL=INFO
